# WorkDesk local environment
# Copy this file to `.env` and adjust as needed. `.env` is ignored by Git.

# Database URL for the local SQLite database (used by Prisma).
# Do not change this unless you are moving the database file.
DATABASE_URL="file:./prisma/workdesk.db"

# Optional: HTTPS endpoint that receives { email, token } for password resets.
# When unset, reset tokens are shown on screen in development only. Set this
# before enabling the recovery flow in production.
PASSWORD_RESET_WEBHOOK_URL=""

# Optional: HTTPS endpoint that receives { email, token, role, workspaceId }
# when invitations are created or resent. When unset, copyable invite links are
# shown in the UI and no email delivery is claimed.
INVITATION_WEBHOOK_URL=""

# Google OAuth is hidden until the provider and callback flow are implemented
# and tested. Do not set these to "true" until that work is complete.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="false"
NEXT_PUBLIC_GOOGLE_OAUTH_READY="false"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CALLBACK_URL=""
