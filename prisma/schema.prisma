generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Specialization {
  DEVELOPER
  DESIGNER
  OTHER
}

enum Status {
  TODO
  IN_PROGRESS
  TESTING
  TESTING_FAILED
  REOPENED
  DONE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueResolution {
  OPEN
  RESOLVED
  CLOSED
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  description String?
  isPersonal  Boolean   @default(false)
  ownerId     String?

  // Projects in this workspace
  projects    Project[]

  // Tasks in this workspace
  tasks       Task[]

  // Members of this workspace
  members     WorkspaceMember[]

  // Invitations to this workspace
  invitations Invitation[]

  // Activity events in this workspace
  activities  Activity[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        String    @default("MEMBER") // "ADMIN", "MANAGER", "MEMBER"
  joinedAt    DateTime  @default(now())

  @@unique([userId, workspaceId])

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invitation {
  id            String    @id @default(uuid())
  token         String    @unique
  workspaceId   String
  email         String?
  role          String    @default("MEMBER") // "ADMIN", "MANAGER", "MEMBER"
  specialization String?
  invitedById   String
  expiresAt     DateTime
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          String    @default("MEMBER")
  specialization Specialization @default(OTHER)
  avatarUrl     String?
  onboardingCompleted Boolean @default(false)
  onboardingStep Int     @default(0)
  onboardingData String?
  checklistDismissed Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Personal workspace - one workspace per user (unique workspaceId)
  workspaceId   String?   @unique

  // Single-use password reset tokens
  passwordResets PasswordResetToken[]

  // Tasks assigned to this user
  assignedTasks Task[]      @relation("AssignedTasks")

  // Tasks created by this user
  createdTasks  Task[]      @relation("CreatedTasks")

  // Workspace memberships
  workspaceMembers WorkspaceMember[]

  // Comments authored by this user
  comments       Comment[]

  // Notifications for this user
  notifications  Notification[]

  // Activities performed by this user
  activities     Activity[]

  // Task lifecycle transitions performed by this user
  taskHistory    TaskHistory[]

  // Issues recorded/resolved by this user
  issuesCreated  Issue[] @relation("IssuesCreated")
  issuesResolved Issue[] @relation("IssuesResolved")

  // Attachments uploaded by this user
  attachments    Attachment[]

  // Links added by this user
  createdLinks   TaskLink[] @relation("TaskLinksCreated")

  // Active login sessions
  sessions       Session[]
}

model Session {
  id          String   @id @default(uuid())
  tokenHash   String   @unique @map("token")
  userId      String
  workspaceId String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Belongs to one workspace (optional for backward compatibility)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  // Tasks in this project
  tasks       Task[]

  @@index([workspaceId, status])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    Priority @default(MEDIUM)
  status      Status   @default(TODO)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Belongs to one project
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Optional assignee from workspace members
  assigneeId  String?
  assignee    User?      @relation("AssignedTasks", fields: [assigneeId], references: [id])

  // Member who created the task (nullable for tasks created before this
  // column existed). Removed users never orphan a task.
  createdById String?
  createdBy   User?      @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  // Workspace assignment
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  // Comments on this task
  comments    Comment[]

  // Lifecycle transition history
  history     TaskHistory[]

  // Number of times this task has been reopened (mirrors history and is
  // incremented atomically with the REOPENED transition).
  reopenCount Int @default(0)

  // Collaboration records
  issues      Issue[]
  attachments Attachment[]
  links       TaskLink[]

  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, projectId])
}

model TaskHistory {
  id            String    @id @default(cuid())
  taskId        String
  fromStatus    Status?
  toStatus      Status
  actorId       String
  reason        String?
  reviewComment String?
  createdAt     DateTime  @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  taskId      String
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String    // "TASK_ASSIGNED", "COMMENT_ADDED", "INVITATION_RECEIVED", "MENTIONED"
  title       String
  body        String?
  link        String?   // Link to relevant task/project
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Stable event key used to make notification delivery idempotent.
  dedupeKey   String?   @unique

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Issue {
  id           String          @id @default(cuid())
  taskId       String
  description  String
  severity     IssueSeverity   @default(MEDIUM)
  resolution   IssueResolution @default(OPEN)
  createdById  String
  resolvedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resolvedAt   DateTime?

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy  User  @relation(fields: [createdById], references: [id], name: "IssuesCreated")
  resolvedBy User? @relation(fields: [resolvedById], references: [id], name: "IssuesResolved")

  @@index([taskId, createdAt])
}

model Attachment {
  id          String   @id @default(cuid())
  taskId      String
  uploaderId  String
  fileName    String
  mimeType    String
  size        Int
  storagePath String   @unique
  createdAt   DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id])

  @@index([taskId, createdAt])
}

model TaskLink {
  id          String   @id @default(cuid())
  taskId      String
  url         String
  title       String?
  createdById String?
  createdAt   DateTime @default(now())

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TaskLinksCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model Activity {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String
  type        String    // "TASK_CREATED", "TASK_UPDATED", "COMMENT_ADDED", "INVITATION_SENT", "MEMBER_JOINED", etc.
  targetId    String?   // ID of the affected entity (task, comment, etc.)
  targetType  String?   // "TASK", "COMMENT", "INVITATION", "MEMBER"
  metadata    String?   // JSON string with additional details
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([actorId])
}